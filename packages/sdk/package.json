{
  "name": "@usdh-kit/sdk",
  "version": "0.3.0",
  "description": "TypeScript SDK for USDH on Hyperliquid",
  "license": "MIT",
  "author": "sumfxn",
  "homepage": "https://github.com/sumfxn/usdh-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sumfxn/usdh-kit.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/sumfxn/usdh-kit/issues"
  },
  "keywords": ["hyperliquid", "usdh", "stablecoin", "swap", "defi", "sdk", "typescript"],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "engines": {
    "node": ">=18.18.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@noble/hashes": "1.6.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "tsup": "8.3.5",
    "vitest": "2.1.8"
  }
}
