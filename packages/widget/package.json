{
  "name": "@usdh-kit/widget",
  "version": "0.0.0",
  "description": "Embeddable React widget for swapping stablecoins into USDH on Hyperliquid",
  "license": "MIT",
  "author": "sumfxn",
  "homepage": "https://github.com/sumfxn/usdh-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sumfxn/usdh-kit.git",
    "directory": "packages/widget"
  },
  "bugs": {
    "url": "https://github.com/sumfxn/usdh-kit/issues"
  },
  "keywords": ["hyperliquid", "usdh", "react", "widget", "swap", "defi"],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "engines": {
    "node": ">=18.18.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5",
    "@usdh-kit/sdk": "workspace:*",
    "react": ">=18",
    "react-dom": ">=18",
    "viem": ">=2",
    "wagmi": ">=2"
  },
  "devDependencies": {
    "@tanstack/react-query": "5.62.7",
    "@types/react": "19.0.1",
    "@types/react-dom": "19.0.2",
    "@usdh-kit/sdk": "workspace:*",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tsup": "8.3.5",
    "typescript": "5.7.2",
    "viem": "2.21.55",
    "wagmi": "2.14.6"
  }
}
