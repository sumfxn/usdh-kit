{
  "name": "@usdh-kit/widget",
  "version": "0.1.0",
  "description": "Embeddable React widget for swapping stablecoins into USDH on Hyperliquid",
  "license": "MIT",
  "author": "sumfxn",
  "homepage": "https://github.com/sumfxn/usdh-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sumfxn/usdh-kit.git",
    "directory": "packages/widget"
  },
  "bugs": {
    "url": "https://github.com/sumfxn/usdh-kit/issues"
  },
  "keywords": ["hyperliquid", "usdh", "react", "widget", "swap", "defi"],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./tailwind-content": {
      "types": "./tailwind-content.d.cts",
      "default": "./tailwind-content.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "tailwind-content.cjs", "tailwind-content.d.cts", "README.md", "LICENSE"],
  "sideEffects": ["./dist/styles.css"],
  "engines": {
    "node": ">=18.18.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "pnpm build:js && pnpm build:css",
    "build:js": "tsup",
    "build:css": "tailwindcss -c tailwind.config.cjs -i ./src/styles.css -o ./dist/styles.css --minify",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5",
    "react": ">=18",
    "react-dom": ">=18",
    "viem": ">=2",
    "wagmi": ">=2"
  },
  "dependencies": {
    "@usdh-kit/sdk": "workspace:^"
  },
  "devDependencies": {
    "@tanstack/react-query": "5.62.7",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/react": "19.0.1",
    "@types/react-dom": "19.0.2",
    "jsdom": "25.0.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwindcss": "3.4.17",
    "tsup": "8.3.5",
    "typescript": "5.7.2",
    "viem": "2.21.55",
    "vitest": "2.1.8",
    "wagmi": "2.14.6"
  }
}
