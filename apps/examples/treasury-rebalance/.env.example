# Copy to .env and fill in. NEVER commit .env.

# Required: HyperEVM private key for the treasury wallet (testnet first).
PRIV_KEY=0x

# Optional: 'mainnet' or 'testnet'. Defaults to testnet.
NETWORK=testnet

# Optional: override the HyperEVM RPC.
# HYPER_EVM_RPC_URL=https://rpc.hyperliquid-testnet.xyz/evm

# Threshold above which the script rebalances. USDC smallest unit (6 dec).
# Default 1_000_000_000 = 1000 USDC.
USDC_FLOOR=1000000000

# Fraction of the excess (above floor) to convert to USDH, in basis points.
# Default 5000 = 50%.
REBALANCE_BPS=5000
