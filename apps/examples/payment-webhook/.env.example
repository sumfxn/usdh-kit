# Copy to .env and fill in. NEVER commit .env.

# Required: HyperEVM private key for the merchant treasury (testnet first).
PRIV_KEY=0x

# Required: Stripe webhook signing secret (whsec_...).
# https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_

# Optional: 'mainnet' or 'testnet'. Defaults to testnet.
NETWORK=testnet

# Optional: HTTP port. Defaults to 4242.
PORT=4242
