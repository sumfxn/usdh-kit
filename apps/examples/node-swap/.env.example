# Copy to .env and fill in. NEVER commit .env.

# Required: HyperEVM private key (testnet recommended for first run).
PRIV_KEY=0x

# Optional: 'mainnet' or 'testnet'. Defaults to testnet.
NETWORK=testnet

# Optional: override the HyperEVM RPC. Defaults to the public HL endpoint.
# HYPER_EVM_RPC_URL=https://rpc.hyperliquid-testnet.xyz/evm

# Optional: amount in USDC smallest unit (6 decimals). Default 1_000_000 = 1 USDC.
AMOUNT_USDC_EVM=1000000
